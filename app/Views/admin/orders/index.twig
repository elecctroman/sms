{% extends 'admin/layout.twig' %}

{% block content %}
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Siparişlerim</h2>
        <a href="/orders/new" class="btn btn-primary">Yeni Sipariş</a>
    </div>
    <table class="table align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Servis</th>
                <th>Durum</th>
                <th>Kod</th>
                <th>Tarih</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
                <tr>
                    <td>{{ order.id }}</td>
                    <td>{{ order.service }}</td>
                    <td><span class="badge badge-status {{ order.status }} text-uppercase">{{ order.status }}</span></td>
                    <td>
                        {% if order.code %}
                            <button class="btn btn-sm btn-outline-secondary" data-copy="{{ order.code }}">{{ order.code }}</button>
                        {% else %}
                            <span class="text-muted">Bekleniyor</span>
                        {% endif %}
                    </td>
                    <td>{{ order.created_at }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
