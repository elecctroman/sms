{% extends 'admin/layout.twig' %}

{% block content %}
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Destek Biletleri</h2>
        <a href="/support/create" class="btn btn-primary">Yeni Bilet</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Konu</th>
                <th>Durum</th>
                <th>Öncelik</th>
            </tr>
        </thead>
        <tbody>
            {% for ticket in tickets %}
                <tr>
                    <td>{{ ticket.id }}</td>
                    <td>{{ ticket.subject }}</td>
                    <td><span class="badge bg-info text-uppercase">{{ ticket.status }}</span></td>
                    <td><span class="badge bg-warning text-uppercase">{{ ticket.priority }}</span></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
