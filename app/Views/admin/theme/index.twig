{% extends 'admin/layout.twig' %}

{% block content %}
<div class="card p-4">
    <h2 class="h4 mb-3">Tema Yönetimi</h2>
    <p>Aktif tema: <strong>landing/default</strong></p>
    <div class="row g-3">
        {% for theme in themes %}
            <div class="col-md-4">
                <div class="card p-3 h-100">
                    <h5>{{ theme.name }}</h5>
                    <p class="text-muted">Slug: {{ theme.slug }}</p>
                    <button class="btn btn-outline-primary">Aktif Et</button>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
