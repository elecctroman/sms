{% extends 'admin/layout.twig' %}

{% block content %}
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card p-4">
            <h2 class="h5">Numara Kirala</h2>
            <form>
                {% for option in options %}
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="period" id="period_{{ option.period }}" {% if loop.first %}checked{% endif %}>
                        <label class="form-check-label" for="period_{{ option.period }}">{{ option.label }} - ₺{{ option.price }}</label>
                    </div>
                {% endfor %}
                <button class="btn btn-primary w-100 mt-3">Kirala</button>
            </form>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card p-4">
            <h2 class="h5">Aktif Kiralama</h2>
            <p class="mb-1">Numara: <strong>{{ activeRental.number }}</strong></p>
            <p class="mb-3">Bitiş: {{ activeRental.ends_at }}</p>
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: 60%;">Kalan süre %60</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
