RewriteEngine On

# Force HTTPS at the root as well
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent rewriting if already under /public
RewriteCond %{REQUEST_URI} ^/public/
RewriteRule ^ - [L]

# Forward all other requests into /public
RewriteRule ^(.*)$ public/$1 [L]
